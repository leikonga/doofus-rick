# Required
DISCORD_TOKEN=your-discord-bot-token
OPENROUTER_API_KEY=your-openrouter-api-key

# Required for slash command registration
DISCORD_GUILD=your-guild-id

# Optional: web UI OAuth (leave blank to skip login enforcement)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:8080/callback
# Required if you want to use the web UI,
SESSION_SECRET=any-random-string

# Optional: extra capabilities
# GIPHY_API_KEY=
# BRAVE_API_KEY=
# SYSTEM_PROMPT_FILE=system_prompt.txt
# RICK_MODEL=openai/gpt-5.6-luna
# RICK_FALLBACK_MODELS=anthropic/claude-sonnet-5,z-ai/glm-5.2,openai/gpt-5.6-luna
# RICK_MAX_TOKENS=16000
# RICK_REASONING_EFFORT=medium
# CODE_MAX_TOKENS=64000
# CODE_REASONING_EFFORT=high

# Optional: sys_shell sandbox. The shell runs as RICK_SHELL_USER; in production
# the bot refuses to start if it cannot switch to that user. Locally a missing
# user falls back to running the shell as yourself.
# RICK_SHELL_USER=rick
# Localhost-only pprof listener for profiling from the shell; set empty to disable.
# RICK_PPROF_ADDR=127.0.0.1:6060

# Database; defaults to SQLite (doofus-rick.db), no further config needed.
# To use postgres instead:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=
# DB_NAME=postgres

# Optional: message archive (requires postgres + pgvector, see README/plans)
# ARCHIVE_ENABLED=true
# ARCHIVE_DENY_CHANNELS=

# Optional: backfill worker, fills the archive from Discord history on boot.
# Slow and rate-limit-adaptive; leave off until the archive is set up.
# BACKFILL_ENABLED=false
# BACKFILL_DELAY=1s
# BACKFILL_BATCH=100

# Optional: chunking for retrieval, closes a chunk on gap/count/char limits
# CHUNK_GAP=10m
# CHUNK_MAX_MSGS=15
# CHUNK_MAX_CHARS=2000

# Optional: embeddings + retrieval
# RICK_EMBED_MODEL=qwen/qwen3-embedding-8b
# RECALL_ENABLED=true
# RECALL_TOP_K=3
# RECALL_MIN_SCORE=0.005
# RECALL_NEIGHBOR_CHUNKS=1

# Optional: ambient awareness, unprompted interjections. Off by default,
# expect to tune the threshold down rather than up.
# AMBIENT_ENABLED=false
# AMBIENT_WINDOW=90s
# AMBIENT_MIN_MSGS=4
# AMBIENT_MIN_AUTHORS=2
# AMBIENT_COOLDOWN=60m
# AMBIENT_DAILY_CAP=5
# AMBIENT_EVAL_DEBOUNCE=60s
# AMBIENT_MIN_SCORE=90
# AMBIENT_MODEL=
# AMBIENT_MAX_TOKENS=8000

# Optional: per-user affinity, biases tone and ambient roast threshold
# AFFINITY_ENABLED=true
# AFFINITY_BASELINE=-20
# AFFINITY_MODEL=

# Optional: typing theatre, fake pause-and-resume before sending
# TYPING_THEATRE=false
# TYPING_MAX_DELAY=20s
# TYPING_CHANCE=0.25
