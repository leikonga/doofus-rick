# Required
DISCORD_TOKEN=your-discord-bot-token
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required for slash command registration
DISCORD_GUILD=your-guild-id

# Optional: web UI OAuth (leave blank to skip login enforcement)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:8080/callback
# Required if you want to use the web UI,
SESSION_SECRET=any-random-string

# Optional: extra capabilities
# GIPHY_API_KEY=
# BRAVE_API_KEY=
# SYSTEM_PROMPT_FILE=system_prompt.txt
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Database; defaults to SQLite (doofus-rick.db), no further config needed.
# To use postgres instead:
# DB_DRIVER=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=
# DB_NAME=postgres
